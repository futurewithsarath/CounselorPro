# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (FOR SECURE ADMINISTRATIVE ACCESS AND FIRESTORE)
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_CLIENT_ID=""

# PUBLIC FIREBASE CLIENT CONFIG (FOR WEB CLIENT INITIALIZATION)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_APP_ID=""

# SINGLE SUPER ADMIN OWNER CONFIGURATION
# Set your actual UID and email address. Read exclusively by server scripts and APIs.
SUPER_ADMIN_UID="2tqT8SPAuqh5H3aw8hBxwsAjgCc2"
SUPER_ADMIN_EMAIL="owner@example.com"

# ADMIN ACCESS ALLOWLIST (Comma-separated list of verified admin email addresses)
# Required for uploading datasets via /api/admin/upload-colleges. Fails closed (403) if missing.
ADMIN_EMAILS="owner@example.com"


