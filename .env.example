# ==============================================================================
# COUNSELORPRO ENVIRONMENT VARIABLES TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this template to .env for local development:
#    cp .env.example .env
# 2. Fill in the values for the services you wish to activate.
# 3. Optional services run in safe local simulation/fallback modes when unset.
# 4. NEVER commit real private keys, passwords, or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Google AI Studio Gemini API Key for /api/ai/analyze-choices.
# When missing in development: AI Counselor runs in local simulation mode.
# When missing in production: AI Counselor returns 500 (fails safely without leaking).
# Obtain a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Optional: Gemini model override (defaults to gemini-2.5-flash)
# Supported models: gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 2. FIREBASE ADMIN SDK CREDENTIALS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Required for authoritative Firestore synchronization and admin operations.
# When missing: Server and API run in local fallback mode using static datasets.
#
# HOW TO OBTAIN:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Go to Project Settings (gear icon) -> "Service accounts" tab.
# 3. Click "Generate new private key" to download the JSON service account file.
# 4. Extract project_id, client_email, and private_key from the JSON:
FIREBASE_PROJECT_ID="counselorpro"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@counselorpro.iam.gserviceaccount.com"
# In .env, the private key should be wrapped in quotes and can include literal \n:
FIREBASE_PRIVATE_KEY="" # Paste private_key string from downloaded JSON (wrapped in quotes with \n)
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_CLIENT_ID=""

# Alternative service account file paths (auto-detected if present; gitignored):
# GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# ------------------------------------------------------------------------------
# 3. SUPER ADMIN RBAC CONFIGURATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Authorized Super Admin UID matching your production account. Dual-checked with custom claims.
SUPER_ADMIN_UID="2tqT8SPAuqh5H3aw8hBxwsAjgCc2"
SUPER_ADMIN_EMAIL="owner@example.com"
ADMIN_EMAILS="owner@example.com"

# ------------------------------------------------------------------------------
# 4. PUBLIC FIREBASE WEB CONFIGURATION (CLIENT & /api/config/firebase)
# ------------------------------------------------------------------------------
# Safe for public web client initialization.
# Prefixed with VITE_ to be automatically bundled by Vite for the frontend.
VITE_FIREBASE_API_KEY="AIzaSyAgfXQFSoGjvSxmskHK4tu97Tt0DopngAg"
VITE_FIREBASE_AUTH_DOMAIN="counselorpro.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="counselorpro"
VITE_FIREBASE_APP_ID="1:289926335025:web:a061b899b2a0a68476a310"
VITE_FIREBASE_STORAGE_BUCKET="counselorpro.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="289926335025"
VITE_FIREBASE_MEASUREMENT_ID="G-RZME2N1DTD"

# Backward-compatibility aliases for serverless endpoint /api/config/firebase:
FIREBASE_API_KEY="AIzaSyAgfXQFSoGjvSxmskHK4tu97Tt0DopngAg"
FIREBASE_AUTH_DOMAIN="counselorpro.firebaseapp.com"
FIREBASE_APP_ID="1:289926335025:web:a061b899b2a0a68476a310"
FIREBASE_STORAGE_BUCKET="counselorpro.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="289926335025"
FIREBASE_MEASUREMENT_ID="G-RZME2N1DTD"

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & DEPLOYMENT SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
