# ==============================================================================
# COUNSELORPRO ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings for production deployment.
# NEVER commit real private keys, passwords, or production secrets to Git.
# ==============================================================================

# 1. AI COUNSELOR CREDENTIALS (SERVER-SIDE ONLY)
# Google AI Studio Gemini API Key for /api/ai/analyze-choices.
GEMINI_API_KEY=""

# 2. FIREBASE ADMIN SDK CREDENTIALS (SERVER-SIDE ONLY)
# Required for serverless Firestore administrative write operations.
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_PROJECT_ID="counselorpro"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@counselorpro.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY=""
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_CLIENT_ID=""

# 3. SUPER ADMIN RBAC CONFIGURATION (SERVER-SIDE ONLY)
# Authorized Super Admin UID matching your production account. Dual-checked with custom claims.
SUPER_ADMIN_UID="2tqT8SPAuqh5H3aw8hBxwsAjgCc2"
SUPER_ADMIN_EMAIL="owner@example.com"
ADMIN_EMAILS="owner@example.com"

# 4. PUBLIC FIREBASE WEB CONFIGURATION (CLIENT & SERVERLESS CONFIG ENDPOINT)
# Safe for public web client initialization.
FIREBASE_API_KEY="AIzaSyAgfXQFSoGjvSxmskHK4tu97Tt0DopngAg"
FIREBASE_AUTH_DOMAIN="counselorpro.firebaseapp.com"
FIREBASE_APP_ID="1:289926335025:web:a061b899b2a0a68476a310"
FIREBASE_STORAGE_BUCKET="counselorpro.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="289926335025"
FIREBASE_MEASUREMENT_ID="G-RZME2N1DTD"

# 5. OPTIONAL / DEPLOYMENT ENVIRONMENT SETTINGS
PORT=3000
NODE_ENV=production
APP_URL="https://counselorpro.vercel.app"



